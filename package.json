{
  "name": "a11y-auditor",
  "version": "1.0.0",
  "description": "Accessibility auditor: VoiceOver screen reader testing (vo-driver) + axe-core automated checks",
  "type": "module",
  "main": "vo-driver.ts",
  "scripts": {
    "start": "bun vo-driver.ts serve",
    "dev": "bun --watch vo-driver.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["voiceover", "accessibility", "automation", "playwright"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@guidepup/guidepup": "^0.24.0",
    "dbus-native": "^0.4.0",
    "playwright": "^1.40.0"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2"
  }
}
