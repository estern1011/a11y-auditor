{
  "name": "a11y-auditor",
  "version": "1.0.0",
  "description": "Accessibility auditor: VoiceOver screen reader testing (vo-driver) + axe-core automated checks",
  "type": "module",
  "main": "drivers/voiceover/driver.ts",
  "scripts": {
    "start": "bun drivers/voiceover/driver.ts serve",
    "dev": "bun --watch drivers/voiceover/driver.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "voiceover",
    "accessibility",
    "automation",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@guidepup/guidepup": "^0.24.0",
    "dbus-native": "^0.4.0",
    "playwright": "^1.40.0"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.2",
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.0.0"
  }
}
