{
  "name": "a11y-auditor",
  "version": "1.0.0",
  "description": "Accessibility auditor: VoiceOver screen reader testing (vo-driver) + axe-core automated checks",
  "type": "module",
  "main": "drivers/voiceover/driver.ts",
  "scripts": {
    "start": "bun drivers/voiceover/driver.ts serve",
    "dev": "bun --watch drivers/voiceover/driver.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "voiceover",
    "accessibility",
    "automation",
    "playwright"
  ],
  "author": "estern1011",
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@guidepup/guidepup": "^0.26.0",
    "dbus-native": "^0.4.0",
    "playwright": "^1.59.1"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
