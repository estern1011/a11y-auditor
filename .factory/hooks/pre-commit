#!/bin/bash
# Factory Claude pre-commit hook
# Runs before Claude makes any commit to ensure code quality

set -e

echo "🔍 Running pre-commit checks..."

# Type check
echo "→ TypeScript type check..."
bun run typecheck

# Lint
echo "→ ESLint..."
bun run lint

# Format check
echo "→ Prettier format check..."
bun run format:check

echo "✅ All pre-commit checks passed!"
