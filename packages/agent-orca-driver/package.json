{
  "name": "agent-orca-driver",
  "version": "0.1.0-dev",
  "description": "Composable Orca + Chromium + Xvfb driver. HTTP daemon any orchestration layer can drive.",
  "type": "module",
  "bin": {
    "agent-orca-driver": "dist/bin/agent-orca-driver.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "SKILL.md",
    "AGENTS.md",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test 'tests/*.test.mjs'",
    "prepack": "npm run build"
  },
  "keywords": [
    "orca",
    "screen-reader",
    "accessibility",
    "wcag",
    "playwright",
    "linux"
  ],
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "axe-core": "^4.11.3",
    "dbus-native": "^0.4.0",
    "playwright": "^1.59.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/ws": "^8.5.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
